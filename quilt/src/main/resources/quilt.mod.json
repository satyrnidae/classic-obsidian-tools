{
  "schema_version": 1,
  "quilt_loader": {
    "group": "${group}",
    "id": "classic_obsidian",
    "version": "${version}",
    "metadata": {
      "name": "Classic Obsidian Tools",
      "description": "Adds unbreakable obsidian tools that work at the same level as stone!",
      "contributors": {
        "satyrnidae": "Author"
      },
      "icon": "icon.png"
    },
    "intermediate_mappings": "net.fabricmc:intermediary",
    "entrypoints": {
      "init": [
        "dev.satyrn.classicobsidian.quilt.InitEntrypoint"
      ],
      "modmenu": [
        "dev.satyrn.classicobsidian.fabriclike.ModMenuEntrypoint"
      ]
    },
    "depends": [
      {
        "id": "quilt_loader",
        "version": "*"
      },
      {
        "id": "quilt_base",
        "version": "*"
      },
      {
        "id": "minecraft",
        "version": ">=1.19.2"
      },
      {
        "id": "architectury",
        "version": ">=6.6.92"
      },
      {
        "id": "cloth-config",
        "version": ">=8.3.134"
      }
    ]
  }
}
